#!/bin/bash
#SBATCH --job-name=merge_evt_tree
#SBATCH --partition=production
#SBATCH --account=clas12
#SBATCH --array=0-1
#SBATCH --mem-per-cpu=5000
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=4:00:00
#SBATCH --chdir=/scratch/slurm
#SBATCH --output=/farm_out/%u/%x-%j-%N.out
#SBATCH --error=/farm_out/%u/%x-%j-%N.err
#
# Merges evt_tree from two sets of ROOT files, one per array task:
#   task 0 -> v5_train.root  (expects 148 input files)
#   task 1 -> v5_test.root   (expects  16 input files)
#
# Submit both:
#   sbatch scripts/submit_merge_evt_tree.sh
#
# Submit with distinct job names (also gives distinct farm_out filenames):
#   sbatch --job-name=merge_v5_train --array=0 scripts/submit_merge_evt_tree.sh
#   sbatch --job-name=merge_v5_test  --array=1 scripts/submit_merge_evt_tree.sh

set -euo pipefail

PROJ_DIR=/w/hallb-scshelf2102/clas12/users/tjhellst/parnassus_data_prep
MERGE_SH="${PROJ_DIR}/scripts/merge_evt_tree.sh"
OUT_DIR=/volatile/clas12/users/tjhellst/parnassus_data/v5/

# ---- EDIT THESE TWO PATHS -------------------------------------------------
TRAIN_DIR="${OUT_DIR}/train_files"
TEST_DIR="${OUT_DIR}/test_files"
# ---------------------------------------------------------------------------

TRAIN_EXPECTED=148
TEST_EXPECTED=16

case "${SLURM_ARRAY_TASK_ID}" in
  0)
    IN_DIR="${TRAIN_DIR}"
    OUT_FILE="${OUT_DIR}/v5_train.root"
    EXPECTED="${TRAIN_EXPECTED}"
    ;;
  1)
    IN_DIR="${TEST_DIR}"
    OUT_FILE="${OUT_DIR}/v5_test.root"
    EXPECTED="${TEST_EXPECTED}"
    ;;
  *)
    echo "ERROR: unexpected SLURM_ARRAY_TASK_ID='${SLURM_ARRAY_TASK_ID}' (expected 0 or 1)" >&2
    exit 1
    ;;
esac

echo "host        : $(hostname)"
echo "job         : ${SLURM_JOB_NAME} ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "input dir   : ${IN_DIR}"
echo "output file : ${OUT_FILE}"
echo "started     : $(date)"

# ROOT environment. Replace with whatever you normally use on ifarm, e.g.
#   module load root
#   source /path/to/root/bin/thisroot.sh
if [[ -n "${ROOTSYS:-}" ]]; then
  echo "ROOTSYS     : ${ROOTSYS}"
else
  echo "WARNING: ROOTSYS is unset; make sure the merge script sets up ROOT itself." >&2
fi

[[ -x "${MERGE_SH}" ]] || { echo "ERROR: not executable: ${MERGE_SH}" >&2; exit 1; }
[[ -d "${IN_DIR}"   ]] || { echo "ERROR: no such directory: ${IN_DIR}" >&2; exit 1; }
mkdir -p "${OUT_DIR}"

# Collect inputs. Sorted so the merge order is reproducible across resubmits.
shopt -s nullglob
mapfile -t FILES < <(printf '%s\n' "${IN_DIR}"/*.root | LC_ALL=C sort)
shopt -u nullglob

if (( ${#FILES[@]} == 0 )); then
  echo "ERROR: no .root files found in ${IN_DIR}" >&2
  exit 1
fi

echo "found       : ${#FILES[@]} .root files (expected ${EXPECTED})"
if (( ${#FILES[@]} != EXPECTED )); then
  echo "WARNING: input count does not match the expected ${EXPECTED}; merging anyway." >&2
fi

# Note the argument order required by merge_evt_tree.sh:
#   OUTPUT_FILE [flags] FILE1 [FILE2 ...]
srun "${MERGE_SH}" "${OUT_FILE}" --force --filterScatE "${FILES[@]}"
status=$?

echo "finished    : $(date)  (exit ${status})"
if [[ -f "${OUT_FILE}" ]]; then
  echo "output size : $(du -h "${OUT_FILE}" | cut -f1)"
fi

exit "${status}"
